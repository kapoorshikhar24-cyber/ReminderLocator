# ==========================================
# GeoRemind - Dual Mode Map Configuration
# ==========================================

# 1. FREE MODE (Default - No API Key Needed)
# Uses OpenStreetMap & Nominatim. Completely free.
VITE_MAP_PROVIDER=osm

# 2. GOOGLE MAPS MODE (Optional)
# If you have a Google Maps API Key, enter it below.
# The app will automatically run in Google Maps Mode with Satellite & Roadmap.
# If left blank, the app will automatically fall back to Free Mode!
VITE_GOOGLE_MAPS_API_KEY="AIzaSyA6mwIb_2h6QIUNMbxxJ5kC5ZjH56Zynw0"

# Other optional providers (CARTO, Mapbox, Stadia):
VITE_MAP_API_KEY=

# ==========================================
# Supabase User Auth & Cloud Sync (Optional)
# ==========================================
# Get these from your Supabase Project Settings > API:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

